<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Distinct on-disk name so the CLI binary can never collide with the tray's
         Beam.exe on a case-insensitive filesystem when both are installed to the same
         directory. The user-facing command name (in help text) stays "beam". -->
    <AssemblyName>Beam.Cli</AssemblyName>
    <RootNamespace>Beam.Cli</RootNamespace>
    <Description>Scriptable command-line front end for Beam (status, apply, restore, DPI, Night Light).</Description>
  </PropertyGroup>

  <!-- The CLI is a composition root: it may reference the application layer and the
       Windows adapters, but never Beam.Tray (the WinForms app). -->
  <ItemGroup>
    <ProjectReference Include="..\Beam.Core\Beam.Core.csproj" />
    <ProjectReference Include="..\Beam.Windows\Beam.Windows.csproj" />
    <ProjectReference Include="..\Beam.App\Beam.App.csproj" />
  </ItemGroup>

</Project>
