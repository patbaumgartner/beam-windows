<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- C1/C4: the settings and diagnostics windows are WPF, hosted inside the single
         tray exe — no MSIX/WinUI packaging needed, the Inno installer stays one file. -->
    <UseWPF>true</UseWPF>
    <AssemblyName>Beam</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Beam</Product>
    <Description>Projector mode for Windows — removes black bars, applies readable DPI, and manages Night Light in duplicate mode.</Description>
  </PropertyGroup>

  <!-- Beam.Tray is the main application that brings everything together. -->
  <ItemGroup>
    <ProjectReference Include="..\Beam.Core\Beam.Core.csproj" />
    <ProjectReference Include="..\Beam.Windows\Beam.Windows.csproj" />
    <ProjectReference Include="..\Beam.App\Beam.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="Beam.Tray.Assets.app.ico" />
    <EmbeddedResource Include="Assets\high-beam.png" LogicalName="Beam.Tray.Assets.high-beam.png" />
  </ItemGroup>

</Project>
