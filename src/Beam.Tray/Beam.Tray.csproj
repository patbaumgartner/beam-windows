<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Beam</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Beam</Product>
    <Description>Projector mode label — removes black bars, applies readable DPI, and manages Night Light in duplicate mode.</Description>
  </PropertyGroup>

  <!-- Beam.Tray is the main application that brings everything together. -->
  <ItemGroup>
    <ProjectReference Include="..\Beam.Core\Beam.Core.csproj" />
    <ProjectReference Include="..\Beam.Windows\Beam.Windows.csproj" />
    <ProjectReference Include="..\Beam.App\Beam.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="Beam.Tray.Assets.app.ico" />
    <None Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\high-beam.png" LogicalName="Beam.Tray.Assets.high-beam.png" />
    <None Include="Assets\high-beam.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
