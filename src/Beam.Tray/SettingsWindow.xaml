<Window x:Class="Beam.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beam settings" Width="560" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14">

      <TextBlock Text="General" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
      <CheckBox Content="Enable Beam" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,2"/>
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="Global hotkey: " VerticalAlignment="Center"/>
        <TextBox Width="120" Text="{Binding Hotkey, Mode=TwoWay}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Win+P stays with Windows (its own projector flyout) — Beam never registers it."
                 Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="When pausing from the tray, pause for: " VerticalAlignment="Center"/>
        <ComboBox Width="160" SelectedIndex="{Binding PausePresetIndex, Mode=TwoWay}">
          <ComboBoxItem Content="Pause for 15 min"/>
          <ComboBoxItem Content="Pause for 1 h"/>
          <ComboBoxItem Content="Pause until I resume"/>
        </ComboBox>
      </StackPanel>

      <TextBlock Text="Projector mode" FontWeight="Bold" FontSize="14" Margin="0,14,0,6"/>
      <CheckBox Content="Control display mode (16:9 on the projector)" IsChecked="{Binding UseMode, Mode=TwoWay}" Margin="0,2"/>
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="Projector screen: " VerticalAlignment="Center"/>
        <ComboBox Width="300" SelectedIndex="{Binding ProjectorTopologyIndex, Mode=TwoWay}" VerticalAlignment="Center">
          <ComboBoxItem Content="Mirror (duplicate) — same image on all screens"/>
          <ComboBoxItem Content="Extend — projector as a second screen"/>
        </ComboBox>
      </StackPanel>
      <CheckBox Content="Prefer the projector's native 16:9 mode" IsChecked="{Binding PreferNativeMode, Mode=TwoWay}" Margin="0,2"/>
      <CheckBox Content="Control DPI" IsChecked="{Binding UseDpi, Mode=TwoWay}" Margin="0,2"/>
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <CheckBox Content="DPI target: " IsChecked="{Binding DpiTargetAuto, Mode=TwoWay}" VerticalAlignment="Center"/>
        <TextBlock Text="Automatic" VerticalAlignment="Center" Margin="4,0"/>
        <TextBox Width="60" Text="{Binding DpiTargetPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
        <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0"/>
      </StackPanel>
      <CheckBox Content="Turn Night Light off while presenting" IsChecked="{Binding UseNightLight, Mode=TwoWay}" Margin="0,2"/>
      <CheckBox Content="Restore display settings when the projector disconnects" IsChecked="{Binding RestoreOnDisconnect, Mode=TwoWay}" Margin="0,2"/>

      <TextBlock Text="Extras" FontWeight="Bold" FontSize="14" Margin="0,14,0,6"/>
      <CheckBox Content="Keep the display awake while presenting" IsChecked="{Binding KeepAwake, Mode=TwoWay}" Margin="0,2"/>
      <CheckBox Content="Silence notifications while presenting (Do Not Disturb)" IsChecked="{Binding DoNotDisturb, Mode=TwoWay}" Margin="0,2"/>
      <CheckBox Content="Switch audio to the projector (HDMI)" IsChecked="{Binding AudioToHdmi, Mode=TwoWay}" Margin="0,2"/>

      <TextBlock Text="Devices" FontWeight="Bold" FontSize="14" Margin="0,14,0,6"/>
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
              <CheckBox Grid.Column="1" Content="Auto-apply" IsChecked="{Binding AutoApply, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0"/>
              <Button Grid.Column="2" Content="Forget" Tag="{Binding Identity}" Click="OnForgetDevice" Padding="6,1"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Advanced" FontWeight="Bold" FontSize="14" Margin="0,14,0,6"/>
      <TextBlock Text="Safe mode is active — automatic fixes are paused." Foreground="DarkRed"
                 Visibility="{Binding SafeModeVisibility}" Margin="0,2"/>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <Button Content="Re-evaluate now" Click="OnReevaluate" Padding="8,2" Margin="0,0,6,0"/>
        <Button Content="Reset safe mode" Click="OnResetSafeMode" Padding="8,2" Margin="0,0,6,0"/>
        <Button Content="Open log folder" Click="OnOpenLogFolder" Padding="8,2" Margin="0,0,6,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <Button Content="Export settings…" Click="OnExportSettings" Padding="8,2" Margin="0,0,6,0"/>
        <Button Content="Reset to defaults" Click="OnResetDefaults" Padding="8,2" Margin="0,0,6,0"/>
        <Button Content="Close" Click="OnClose" Padding="8,2"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
