<Window x:Class="Beam.Tray.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beam diagnostics" Width="720" Height="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="HeaderLine" FontWeight="Bold" Margin="0,0,0,8"/>

    <ListBox Grid.Row="1" x:Name="EventList" FontFamily="Consolas" FontSize="12"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Copy summary" Click="OnCopySummary" Padding="8,2" Margin="0,0,6,0"/>
      <Button Content="Export bundle…" Click="OnExportBundle" Padding="8,2" Margin="0,0,6,0"/>
      <Button Content="Re-evaluate now" Click="OnReevaluate" Padding="8,2" Margin="0,0,6,0"/>
      <Button Content="Reset safe mode" Click="OnResetSafeMode" Padding="8,2" Margin="0,0,6,0"/>
      <Button Content="Close" Click="OnClose" Padding="8,2"/>
    </StackPanel>

    <TextBlock Grid.Row="3" x:Name="StatusLine" Foreground="Gray" Margin="0,6,0,0"/>
  </Grid>
</Window>
